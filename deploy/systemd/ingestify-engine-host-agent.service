[Unit]
Description=Ingestify restricted engine host agent
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /var/app/ingestify-to-ai/scripts/engine_host_agent.py --config /etc/ingestify/engine-host.json
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ingestify-engine-agent /etc/ingestify

[Install]
WantedBy=multi-user.target
