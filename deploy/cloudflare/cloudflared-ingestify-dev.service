[Unit]
Description=Cloudflare Tunnel - Ingestify development
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=ingestify-tunnel
Group=ingestify-tunnel
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /var/lib/cloudflared-ingestify/config.yml tunnel run
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
