      {
       "maximum": 1000.0,
       "minimum": 0.0,
       "type": "number"
      },
      {
       "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
       "type": "string"
      }
     ],
     "default": "0",
     "title": "Max Usd"
    },
    "max_warm_seconds": {
