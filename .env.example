# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Conversion Settings
MAX_FILE_SIZE_MB=50
CONVERSION_TIMEOUT_SECONDS=300
TEMP_STORAGE_PATH=/tmp/doc2md

# Docling Performance Settings (optimize for speed)
DOCLING_ENABLE_OCR=False         # Set to True only for scanned PDFs (slower)
DOCLING_ENABLE_TABLE_STRUCTURE=True  # Set to False if no tables needed (faster)
DOCLING_USE_V2_BACKEND=True      # Use beta backend (10x faster)

# Storage Settings
RESULT_TTL_SECONDS=3600
CLEANUP_INTERVAL_HOURS=24

# Google Drive (optional)
GOOGLE_DRIVE_CREDENTIALS_PATH=/secrets/gdrive.json

# Dropbox (optional)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# JWT Authentication (REQUIRED - the app refuses to start without it)
# Signing key for user session tokens. There is NO default: a default here
# would be a published signing key and anyone could forge valid tokens.
# Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# MinIO Object Storage (REQUIRED - the app refuses to start without these)
# Credentials used by the API/worker to talk to MinIO. They must match the
# MinIO server credentials (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD below).
# "minioadmin" is rejected. Generate a password with:
#   openssl rand -hex 24
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# MinIO server credentials (REQUIRED by docker-compose.yml - no defaults)
# These configure the MinIO container itself; mirror them into
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY above.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# CORS (optional - defaults to local development origins)
# Comma-separated allowlist of browser origins permitted to call the API.
# Wildcards are NOT supported: credentials are allowed, so each origin must be
# listed explicitly. In production set this to your real frontend origin, e.g.
#   CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
