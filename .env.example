# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Conversion Settings
MAX_FILE_SIZE_MB=50
CONVERSION_TIMEOUT_SECONDS=300
TEMP_STORAGE_PATH=/tmp/doc2md

# =====================================================================
# Device / GPU
# =====================================================================
# THE single device knob for the whole stack (Docling, Whisper, Florence-2).
#
#   auto     CUDA if torch reports a usable device, else CPU. Silent, one INFO
#            log saying which was chosen. This is the right value for almost
#            everyone, including every machine with no GPU.
#   cpu      Force CPU everywhere.
#   cuda     Force CUDA. If it cannot be satisfied the process fails LOUDLY
#            instead of silently downgrading - that is the only difference
#            between `cuda` and `auto`. Use it when you want to be sure the GPU
#            is actually being used.
#   cuda:N   A specific GPU index on a multi-GPU box.
#
# Setting DEVICE=cuda here is NOT enough on its own: the containers must also
# have been built with the CUDA wheels and given a GPU reservation. Use
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build
# or `make gpu`. Full walkthrough in docs/GPU.md.
DEVICE=auto

# Docling Performance Settings (optimize for speed)
DOCLING_ENABLE_OCR=False         # Set to True only for scanned PDFs (slower)
DOCLING_ENABLE_TABLE_STRUCTURE=True  # Set to False if no tables needed (faster)
DOCLING_USE_V2_BACKEND=True      # NOTE: read by nothing today - kept for compat
# Intra-op threads handed to docling's AcceleratorOptions. With `replicas: 5` x
# `--concurrency=2` the default of 4 keeps 10 processes from oversubscribing the
# host CPU. Raise it only if you also lower replicas/concurrency.
DOCLING_NUM_THREADS=4
# NOTE: DOCLING_DEVICE is now IGNORED. The device is passed explicitly into
# AcceleratorOptions(device=...) from DEVICE above, and a pydantic-settings init
# kwarg outranks the environment. Use DEVICE.

# =====================================================================
# Audio transcription (Whisper)
# =====================================================================
ENABLE_AUDIO_TRANSCRIPTION=true
AUDIO_TRANSCRIBER_PROVIDER=faster-whisper   # faster-whisper | openai-whisper | openai-api
WHISPER_MODEL=turbo                         # tiny | base | small | medium | large | turbo

# Per-component device override for audio ONLY.
#
#   (empty)  Inherit DEVICE. This is the default and what you want.
#   cpu      Pin transcription to CPU even when DEVICE=cuda.
#   cuda     Pin transcription to CUDA even when DEVICE=cpu.
#
# MIGRATION: unset used to mean "cpu"; it now means "inherit DEVICE". This
# variable did not exist before, so if you are upgrading you are in this case.
# On a GPU box that previously ran Whisper on CPU by omission, Whisper will now
# try CUDA. That is deliberate - CPU-Whisper beside GPU-Docling was the
# incoherence being fixed. To keep the old behaviour set WHISPER_DEVICE=cpu.
# Full rationale, including what was rejected:
#   docs/specs/0002-dispositivo-unico-e-migracao-do-whisper.md
#
# Two WARNINGs tell you which case you are in - you will see at most one:
#   "WHISPER_DEVICE=x overrides DEVICE=y"   you set it; nothing changed for you
#   "transcription now runs on cuda ..."    you did NOT set it and audio just
#                                           moved off CPU because of the upgrade
#
# Guard: even with cuda resolved, the resolver falls back to CPU with a logged
# WARNING naming the reason when ctranslate2 cannot really run on CUDA here
# (no CUDA compute type, or libcudnn_ops.so.9 does not load), rather than dying
# on the opaque `Unable to load libcudnn_ops.so.9` on every request. This
# applies to an explicit WHISPER_DEVICE=cuda too.
WHISPER_DEVICE=

# Quantisation handed to CTranslate2.
#   (empty)  Derive from the resolved audio device: float16 on cuda, int8 on cpu.
#   int8     Fast on CPU.
#   float16  The right choice on CUDA.
# Empty is the default and closes the trap where flipping only the device leaves
# CTranslate2 on a CPU-shaped int8 quantisation, which it silently downgrades
# rather than rejecting. A non-empty value is an override and is logged at INFO.
WHISPER_COMPUTE_TYPE=

# =====================================================================
# Vision - image description and OCR (Florence-2)
# =====================================================================
# One flag for the whole feature: both POST /images/describe and
# POST /images/ocr sit behind one model behind one loader, so two flags would
# allow a state that cannot exist. false => every /images/* route returns 503.
ENABLE_IMAGE_DESCRIPTION=true

# florence2 = the real model. stub = a deterministic in-repo fake with zero
# heavy imports; the test suite uses it so pytest stays free of torch.
VISION_PROVIDER=florence2

# HuggingFace repo id. The default florence-community conversion is weights-only
# (safetensors + configs, no .py files) and loads through transformers' NATIVE
# Florence2ForConditionalGeneration - which is exactly why
# VISION_TRUST_REMOTE_CODE can stay false. base-ft (0.23B) is chosen over
# large-ft (0.77B) so it stays viable on a CPU laptop inside the 60s budget.
# Do NOT point this at a microsoft/Florence-2-* repo unless you also accept
# VISION_TRUST_REMOTE_CODE=true.
VISION_MODEL_ID=florence-community/Florence-2-base-ft

# Commit sha, NEVER a branch name - a floating branch means the weights can
# change under you between two deploys.
# If you change VISION_MODEL_ID you MUST change this too; the app refuses to
# start with a changed model id and the default model's sha. Look yours up at
#   https://huggingface.co/<VISION_MODEL_ID>/commits/main
# Known pins (verified 2026-08-26):
#   florence-community/Florence-2-base-ft   0b03b6f15a4a211370fb204aee4e7dd48887ea37
#   florence-community/Florence-2-base      00921df66db728a9ceb750f5eca43e5c203a2051
#   florence-community/Florence-2-large-ft  26b734a54fdfbf9c398351eedfabb7f27fc470b7
#   florence-community/Florence-2-large     4271c66b88cdbc05735372ec13b2360108de5317
VISION_MODEL_REVISION=0b03b6f15a4a211370fb204aee4e7dd48887ea37

# DANGEROUS. true makes from_pretrained DOWNLOAD AND EXECUTE Python from the
# Hub inside the worker process - with that process's filesystem, network,
# MinIO credentials and DATABASE_URL. Only needed for the original
# microsoft/Florence-2-* repos (tagged `custom_code`). The default model does
# not need it, so leave it false and the stack executes no Hub-supplied code.
# Nothing ever enables this implicitly, including as a retry after a load failure.
VISION_TRUST_REMOTE_CODE=false

# Where the ~0.5GB of weights are cached. In Docker this path is backed by the
# named volume `ingestify-hf-cache`, shared by worker and worker-vision, so the
# download survives restarts. Weights are never baked into an image.
VISION_MODEL_CACHE_DIR=/models/huggingface

# false => local_files_only=True on every load. Set it false for air-gapped or
# CI deployments and prefetch the weights with `make vision-download`; a missing
# cache then fails immediately instead of blocking on a network call inside a
# request.
VISION_ALLOW_MODEL_DOWNLOAD=true

# true => load the weights at worker-process start. The worker-vision compose
# service sets this, because otherwise the first request pays a 5-15s (CPU) load
# inside its 60s budget and a first-ever request also pays the ~0.5GB download
# and will 504. Keep it false for the general worker, beat and the API.
VISION_PRELOAD_MODEL=false

# Dedicated Celery queue for the vision tasks. Non-negotiable given the sync
# design: on the shared `ingestify` queue a 60s request would sit behind a
# 10-minute PDF merge and 504 for reasons unrelated to vision.
VISION_QUEUE=ingestify-vision

# API-side deadline: how long the synchronous handler waits for the result
# before returning 504 (with job_id + poll_url, so the work is not lost).
# Must stay BELOW your reverse proxy's read timeout.
VISION_REQUEST_TIMEOUT_SECONDS=60
# Per-task time limit. Deliberately DOUBLE the request timeout so a request that
# 504s leaves a task still running to completion - the job then reaches
# `completed` and the caller fetches it from /jobs/{job_id}/result.
VISION_TASK_TIMEOUT_SECONDS=120

# Its own limit - images deliberately do NOT inherit MAX_FILE_SIZE_MB (50).
# Checked against the DECODED bytes, not the base64 length. Over => 413.
VISION_MAX_IMAGE_SIZE_MB=10
# Decompression-bomb guard: a 10MB PNG can expand to tens of gigabytes, so the
# byte limit alone does not protect the worker. Over => 422.
VISION_MAX_IMAGE_PIXELS=50000000

# generate() knobs. 1024 / 3 match the transformers Florence-2 reference usage.
# Lowering VISION_NUM_BEAMS to 1 roughly HALVES CPU latency at some quality
# cost - the first thing to try if you are 504ing on a CPU-only box.
VISION_MAX_NEW_TOKENS=1024
VISION_NUM_BEAMS=3

# auto | float32 | float16 | bfloat16.
# auto = float16 on cuda, float32 on cpu (float16 on CPU is slow and
# numerically unstable for this model). Leave it auto.
VISION_TORCH_DTYPE=auto

# Default Florence-2 task prompt for POST /images/describe when the caller
# passes none. Callers may override per request with <CAPTION> or
# <DETAILED_CAPTION> only. OCR is always <OCR_WITH_REGION> and is not
# configurable.
VISION_CAPTION_TASK=<MORE_DETAILED_CAPTION>

# Audio/video transcription (Whisper)
WHISPER_MODEL=turbo
WHISPER_DEVICE=auto              # auto = GPU if available (detected once per worker, CPU fallback), cuda, cpu
WHISPER_COMPUTE_TYPE=auto        # auto = float16 on GPU, int8 on CPU
MAX_AUDIO_FILE_SIZE_MB=50
MAX_VIDEO_FILE_SIZE_MB=500

# Storage Settings
RESULT_TTL_SECONDS=3600
CLEANUP_INTERVAL_HOURS=24

# Google Drive (optional)
GOOGLE_DRIVE_CREDENTIALS_PATH=/secrets/gdrive.json

# Dropbox (optional)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# JWT Authentication (REQUIRED - the app refuses to start without it)
# Signing key for user session tokens. There is NO default: a default here
# would be a published signing key and anyone could forge valid tokens.
# Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# MinIO Object Storage (REQUIRED - the app refuses to start without these)
# Credentials used by the API/worker to talk to MinIO. They must match the
# MinIO server credentials (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD below).
# "minioadmin" is rejected. Generate a password with:
#   openssl rand -hex 24
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# Address the BROWSER uses to reach MinIO (optional).
# Presigned URLs (used for the PDF preview) are signed over the Host header, so
# this must be exactly the host:port the browser will request - it is usually
# NOT the same as MINIO_ENDPOINT, which is the in-network address.
# Leave it unset and the API derives it from the request host + port 9000, which
# is correct for docker-compose and for run_api.sh when MinIO's port 9000 is
# published on the same machine/IP the frontend is served from.
# Set it explicitly when MinIO sits behind a reverse proxy, uses TLS, or is
# published on a different host/port, e.g.:
#   MINIO_PUBLIC_ENDPOINT=storage.example.com
# MINIO_PUBLIC_ENDPOINT=

# MinIO server credentials (REQUIRED by docker-compose.yml - no defaults)
# These configure the MinIO container itself; mirror them into
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY above.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# CORS (optional - defaults to local development origins)
# Comma-separated allowlist of browser origins permitted to call the API.
# Wildcards are NOT supported: credentials are allowed, so each origin must be
# listed explicitly. In production set this to your real frontend origin, e.g.
#   CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Admin access: comma-separated user IDs (see GET /auth/me). Empty = no admins.
ADMIN_USER_IDS=
