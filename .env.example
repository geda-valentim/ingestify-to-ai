# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Conversion Settings
MAX_FILE_SIZE_MB=50
CONVERSION_TIMEOUT_SECONDS=300
TEMP_STORAGE_PATH=/tmp/doc2md

# Docling Performance Settings (optimize for speed)
DOCLING_ENABLE_OCR=False         # Set to True only for scanned PDFs (slower)
DOCLING_ENABLE_TABLE_STRUCTURE=True  # Set to False if no tables needed (faster)
DOCLING_USE_V2_BACKEND=True      # Use beta backend (10x faster)

# Audio/video transcription (Whisper)
WHISPER_MODEL=turbo
WHISPER_DEVICE=auto              # auto = GPU if available (detected once per worker, CPU fallback), cuda, cpu
WHISPER_COMPUTE_TYPE=auto        # auto = float16 on GPU, int8 on CPU
MAX_AUDIO_FILE_SIZE_MB=50
MAX_VIDEO_FILE_SIZE_MB=500

# Storage Settings
RESULT_TTL_SECONDS=3600
CLEANUP_INTERVAL_HOURS=24

# Google Drive (optional)
GOOGLE_DRIVE_CREDENTIALS_PATH=/secrets/gdrive.json

# Dropbox (optional)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# JWT Authentication (REQUIRED)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Admin access: comma-separated user IDs (see GET /auth/me). Empty = no admins.
ADMIN_USER_IDS=
